rules_version = '2';

// Firestore security rules: the database's guard. They run on Google's servers, so nobody can
// skip them from the browser. Paste this into Firebase Console -> Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // users: anyone logged in can read a profile (to show names);
    // you can only write your OWN profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // listings: since Nov 15, only our Express server reads and writes listings.
    // The server uses Firebase Admin, which skips these rules, and it does its own checks
    // (server/auth.js and server/listings.js). Blocking everyone else here means nobody can
    // skip our server's checks by calling Firestore directly from the browser.
    match /listings/{listingId} {
      allow read, write: if false;
    }

    // orders (Nov 17): the same as listings. Only our server (server/orders.js) reads and
    // writes them, so nobody can change an order's status or skip the stock check.
    match /orders/{orderId} {
      allow read, write: if false;
    }
  }
}
