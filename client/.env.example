# Copy this file, name the copy ".env" (in this same client folder), and paste your keys after each "=".
# Get the keys from Firebase Console -> Project settings -> Your apps -> Web app -> Config.
# .env is in .gitignore, so your keys never go to GitHub. Never paste keys in chat.
# After changing .env, stop "npm start" (Ctrl + C) and start it again.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
